{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schemas/receiver-environment-profile-1.0.schema.json",
  "title": "Limitless receiver environment profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environments", "bindings"],
  "properties": {
    "schemaVersion": {"const": "limitless.receiver-environment-profile/1.0"},
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "facts", "observation"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["compute", "physical-device", "human-observer"]},
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "architecture", "runtime", "version", "versionRange", "interfaces", "attributes"],
            "properties": {
              "platform": {"anyOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
              "architecture": {"anyOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
              "runtime": {"anyOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
              "version": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 80}, {"type": "null"}]},
              "versionRange": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 120}, {"type": "null"}]},
              "interfaces": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/interface"}},
              "attributes": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {
                    "name": {"$ref": "#/$defs/interface"},
                    "value": {"type": "string", "minLength": 1, "maxLength": 256}
                  }
                }
              }
            }
          },
          "observation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "authority", "observedAt", "evidenceDigest"],
            "properties": {
              "source": {"enum": ["host-detected", "user-declared", "remote-observed", "receiver-observed", "physical-witness"]},
              "authority": {"$ref": "#/$defs/id"},
              "observedAt": {"type": "string", "format": "date-time"},
              "evidenceDigest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentHost", "workEnvironment", "targetEnvironments", "verificationReceivers"],
      "properties": {
        "agentHost": {"$ref": "#/$defs/id"},
        "workEnvironment": {"$ref": "#/$defs/id"},
        "targetEnvironments": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "verificationReceivers": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,199}$"},
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "interface": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
