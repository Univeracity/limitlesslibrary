{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/query-policy-1.0.json",
  "title": "Owner objective-query policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "executionMode", "localReceiver", "serviceReceiver", "requestedUses", "tenantScopes", "allowExact"],
  "properties": {
    "schemaVersion": {"const": "limitless.query-policy/1.0"},
    "executionMode": {"enum": ["local", "service"]},
    "allowExact": {"type": "boolean"},
    "localReceiver": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/localReceiver"}]},
    "serviceReceiver": {"type": ["object", "null"]},
    "requestedUses": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "tenantScopes": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
  },
  "$defs": {
    "localReceiver": {
      "type": "object", "additionalProperties": false, "required": ["constraints", "toolchain"],
      "properties": {
        "constraints": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "toolchain": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    }
  }
}
