{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/verifier-result-0.1.json",
  "title": "Limitless receiver-owned verifier result alpha",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifierId", "kind", "passed", "checks", "assetDigest", "immutableBytes", "runtimeInvoked", "invocationCount"],
  "properties": {
    "schemaVersion": {"const": "limitless.verifier-result/0.1"},
    "verifierId": {"type": "string"},
    "kind": {"enum": ["adherence", "obligation"]},
    "passed": {"const": true},
    "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assetDigest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "immutableBytes": {"oneOf": [{"type": "null"}, {"const": true}]},
    "runtimeInvoked": {"oneOf": [{"type": "null"}, {"const": true}]},
    "invocationCount": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "adherence"}}}, "then": {"properties": {"assetDigest": {"type": "string"}, "immutableBytes": {"const": true}, "runtimeInvoked": {"const": true}, "invocationCount": {"type": "integer"}}}},
    {"if": {"properties": {"kind": {"const": "obligation"}}}, "then": {"properties": {"assetDigest": {"type": "null"}, "immutableBytes": {"type": "null"}, "runtimeInvoked": {"type": "null"}, "invocationCount": {"type": "null"}}}}
  ]
}
