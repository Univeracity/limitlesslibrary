{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/objective-query-1.0.json",
  "title": "Objective-only query",
  "type": "object", "additionalProperties": false, "required": ["objective"],
  "properties": {"objective": {"type": "string", "minLength": 1, "maxLength": 480, "pattern": "^[^\\u0000]+$"}}
}
