{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/adoption-receipt-0.1.json",
  "title": "Limitless verified technical adoption receipt alpha",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "decisionDigest", "recipeDigest", "capsule", "offerId", "installedFiles", "verifierResults", "receiverStateDigest", "containment", "disposition", "receiptDigest"],
  "properties": {
    "schemaVersion": {"const": "limitless.adoption-receipt/0.1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "decisionDigest": {"$ref": "#/$defs/digest"},
    "recipeDigest": {"$ref": "#/$defs/digest"},
    "capsule": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest", "license"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}, "license": {"type": "string"}}
    },
    "offerId": {"type": "string"},
    "installedFiles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "target", "digest"],
        "properties": {"source": {"type": "string"}, "target": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}
      }
    },
    "verifierResults": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "verifierDigest", "resultDigest"],
        "properties": {"id": {"type": "string"}, "kind": {"enum": ["adherence", "obligation"]}, "verifierDigest": {"$ref": "#/$defs/digest"}, "resultDigest": {"$ref": "#/$defs/digest"}}
      }
    },
    "receiverStateDigest": {"$ref": "#/$defs/digest"},
    "containment": {
      "type": "object", "additionalProperties": false, "required": ["network", "filesystem", "secrets", "runner"],
      "properties": {"network": {"const": "none"}, "filesystem": {"const": "read-only-worktree"}, "secrets": {"const": "none"}, "runner": {"const": "bubblewrap"}}
    },
    "disposition": {
      "type": "object", "additionalProperties": false, "required": ["technicalIntegrationVerified", "runtimeAdherenceVerified", "ownerAuthorization"],
      "properties": {"technicalIntegrationVerified": {"const": true}, "runtimeAdherenceVerified": {"const": true}, "ownerAuthorization": {"const": "operator-asserted"}}
    },
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
