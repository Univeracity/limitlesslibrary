{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/capsule-0.1.json",
  "title": "Limitless public Work Capsule alpha",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "license", "offers", "capsuleDigest"],
  "properties": {
    "schemaVersion": {"const": "limitless.capsule/0.1"},
    "id": {"type": "string", "pattern": "^capsule:[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "license": {"type": "string", "minLength": 1, "maxLength": 100},
    "offers": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/offer"}},
    "capsuleDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["constraints", "toolchain"],
      "properties": {
        "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "toolchain": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["allowedUses", "tenantScopes", "state"],
      "properties": {
        "allowedUses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "tenantScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "state": {"enum": ["active", "withdrawn", "superseded", "revoked"]}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["source", "digest"],
      "properties": {"source": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "method": {
      "type": "object", "additionalProperties": false, "required": ["summary", "steps", "verification"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "steps": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "verification": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    },
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "priority", "taskKind", "compatibility", "policy", "files", "method"],
      "properties": {
        "id": {"type": "string", "pattern": "^offer:[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "kind": {"enum": ["exact-component", "method"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "taskKind": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "policy": {"$ref": "#/$defs/policy"},
        "files": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}]},
        "method": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/method"}]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "exact-component"}}}, "then": {"properties": {"files": {"type": "array"}, "method": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "method"}}}, "then": {"properties": {"files": {"type": "null"}, "method": {"type": "object"}}}}
      ]
    }
  }
}
