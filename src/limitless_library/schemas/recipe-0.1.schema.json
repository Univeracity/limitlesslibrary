{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limitlesslibrary.com/schema/recipe-0.1.json",
  "title": "Limitless receiver-owned adoption recipe alpha",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "offerRef", "mappings", "verifiers", "recipeDigest"],
  "properties": {
    "schemaVersion": {"const": "limitless.recipe/0.1"},
    "id": {"type": "string", "pattern": "^recipe:[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "offerRef": {
      "type": "object", "additionalProperties": false, "required": ["capsuleDigest", "offerId"],
      "properties": {"capsuleDigest": {"$ref": "#/$defs/digest"}, "offerId": {"type": "string", "pattern": "^offer:"}}
    },
    "mappings": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["source", "target"],
        "properties": {"source": {"$ref": "#/$defs/path"}, "target": {"$ref": "#/$defs/path"}}
      }
    },
    "verifiers": {"type": "array", "minItems": 2, "maxItems": 50, "items": {"$ref": "#/$defs/verifier"}},
    "recipeDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source", "argv", "maxWallSeconds"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "kind": {"enum": ["adherence", "obligation"]},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["path", "digest"],
          "properties": {"path": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}
        },
        "argv": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "maxWallSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }
    }
  }
}
